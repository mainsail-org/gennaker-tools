# Supply-chain hardening, ported from pnpm-workspace.yaml.
#
# min-release-age is in DAYS (pnpm's minimumReleaseAge was in minutes):
# the previous 25200 minutes = 17.5 days, rounded up to stay at least as strict.
# Requires npm >= 11.10.0; older npm CLIs warn about an unknown config and
# silently ignore it. engine-strict below turns that silent failure into a
# loud one by refusing to install on a Node version that predates it.
min-release-age=18

# Enforces the "engines" field in package.json, so an npm too old to honour
# min-release-age fails the install instead of quietly ignoring the cooldown.
engine-strict=true

# Replaces pnpm's `allowBuilds`. No dependency in this tree needs an install
# script (the only pnpm allowBuilds entry, @fortawesome/fontawesome-free, is not
# a dependency), so refusing them all is the faithful port.
# Note: this also skips pre/post hooks for this project's own scripts; none are
# defined in package.json today.
ignore-scripts=true
